---
import { baseUrl } from '../utils/url';

interface Props {
  trip: {
    id: string;
    data: {
      titulo: string;
      ciudad: string;
      pais: string;
      motivo: string;
      fecha: Date;
      foto: string;
      resumen: string;
    };
  };
}

const { trip } = Astro.props;
const { data } = trip;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
}).format(data.fecha);

const isWork = data.motivo.toLowerCase() === 'work' || data.motivo.toLowerCase() === 'trabajo';
---

<article class="bg-white rounded-2xl border border-amber-900/10 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col group">
  {/* Travel Image Cover */}
  <div class="h-48 sm:h-52 w-full overflow-hidden bg-slate-100 relative">
    <img
      src={baseUrl(data.foto)}
      alt={data.titulo}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    {/* Motivo Badge */}
    <div class="absolute top-3 right-3">
      <span class={`px-2.5 py-1 rounded-full text-xs font-bold shadow-md ${
        isWork ? 'bg-amber-500 text-pizarra' : 'bg-emerald-600 text-espuma'
      }`}>
        {isWork ? '💼 Research & Work' : '🏖️ Leisure'}
      </span>
    </div>
  </div>

  <div class="p-6 flex flex-col justify-between flex-grow">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-2">
        <span>📍 {data.ciudad}, {data.pais}</span>
        <span>•</span>
        <span>{formattedDate}</span>
      </div>

      <h3 class="font-display font-extrabold text-xl text-pizarra group-hover:text-verde-bosque transition-colors leading-tight mb-3">
        <a href={baseUrl(`/viajes/${trip.id}`)}>
          {data.titulo}
        </a>
      </h3>

      <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed">
        {data.resumen}
      </p>
    </div>

    <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
      <span class="text-xs font-medium text-slate-400">
        Read travel chronicle
      </span>
      <a
        href={baseUrl(`/viajes/${trip.id}`)}
        class="inline-flex items-center gap-1.5 text-xs font-bold text-verde-bosque hover:text-verde-lupulo group/link"
      >
        <span>View chronicle</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
