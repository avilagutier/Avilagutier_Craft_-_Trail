---
import { baseUrl } from '../utils/url';

const pathname = Astro.url.pathname;

const navItems = [
  { name: 'Home', href: baseUrl('/'), icon: '🏔️' },
  { name: 'Craft Tasted', href: baseUrl('/cervezas'), icon: '🍺' },
  { name: 'Travels', href: baseUrl('/viajes'), icon: '✈️' },
  { name: 'Trekking', href: baseUrl('/trekking'), icon: '🥾' },
  { name: 'Global Map', href: baseUrl('/mapa'), icon: '🗺️', highlight: true },
];

function isActive(itemHref: string) {
  const current = pathname.replace(/\/$/, '') || '/';
  const target = itemHref.replace(/\/$/, '') || '/';
  if (target === baseUrl('/') || target === '/') {
    return current === target;
  }
  return current.startsWith(target);
}
---

<header class="sticky top-0 z-50 bg-espuma/95 backdrop-blur-md border-b border-amber-900/10 shadow-sm transition-all duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      {/* Brand & Logo */}
      <a href={baseUrl('/')} class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-verde-lupulo rounded-xl p-1">
        <div class="w-10 h-10 sm:w-12 sm:h-12 relative flex-shrink-0 transition-transform duration-300 group-hover:scale-105">
          <img 
            src={baseUrl('/images/logos/Avilagutier_logo_A.svg')} 
            alt="Avilagutier Logo" 
            class="w-full h-full object-contain filter drop-shadow-sm"
            width="48"
            height="48"
          />
        </div>
        <div class="flex flex-col">
          <span class="font-display font-extrabold text-base sm:text-lg tracking-wider text-pizarra group-hover:text-verde-bosque transition-colors leading-tight">
            AVILAGUTIER
          </span>
          <span class="text-[10px] sm:text-xs font-semibold tracking-widest uppercase text-ambar-malta">
            Craft &amp; Trail
          </span>
        </div>
      </a>

      {/* Desktop Navigation */}
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class={`px-3 py-2 rounded-lg text-sm font-semibold transition-all duration-150 flex items-center gap-1.5 ${
                item.highlight
                  ? 'bg-verde-bosque text-espuma hover:bg-verde-lupulo shadow-sm hover:shadow'
                  : active
                  ? 'bg-amber-100/80 text-verde-bosque font-bold border-b-2 border-verde-lupulo'
                  : 'text-pizarra/80 hover:text-pizarra hover:bg-amber-50/80'
              }`}
            >
              <span>{item.icon}</span>
              <span>{item.name}</span>
            </a>
          );
        })}
      </nav>

      {/* Mobile Hamburger Button */}
      <div class="flex items-center md:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="p-2.5 rounded-xl text-pizarra hover:bg-amber-100/60 focus:outline-none focus:ring-2 focus:ring-verde-lupulo transition-colors"
        >
          <svg id="hamburger-icon" class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 stroke-current hidden" fill="none" viewBox="0 0 24 24" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  {/* Mobile Menu Dropdown */}
  <div
    id="mobile-menu"
    class="hidden md:hidden border-b border-amber-900/10 bg-espuma/98 backdrop-blur-lg px-4 pt-2 pb-6 space-y-2 shadow-xl animate-fadeIn"
  >
    <div class="space-y-1 pt-1">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`flex items-center justify-between px-4 py-3 rounded-xl text-base font-medium transition-all ${
              item.highlight
                ? 'bg-verde-bosque text-espuma font-bold shadow-md'
                : active
                ? 'bg-amber-100 text-verde-bosque font-bold border-l-4 border-verde-lupulo'
                : 'text-pizarra hover:bg-amber-50'
            }`}
          >
            <span class="flex items-center gap-3">
              <span class="text-xl">{item.icon}</span>
              <span>{item.name}</span>
            </span>
            <svg class="w-4 h-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        );
      })}
    </div>

    {/* Quick Mobile Bio / Motto */}
    <div class="mt-4 pt-3 border-t border-amber-900/10 text-center">
      <p class="text-xs text-pizarra/60">
        Alpine summits, wild trails, and the finest craft beer explorations.
      </p>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');

  if (btn && menu && hamburger && close) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      hamburger.classList.toggle('hidden');
      close.classList.toggle('hidden');
    });

    // Close on link click
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        close.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
