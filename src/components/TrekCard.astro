---
import { baseUrl } from '../utils/url';

interface Props {
  trek: {
    id: string;
    data: {
      nombre: string;
      lugar: string;
      distancia_km: number;
      desnivel: number | string;
      fecha: Date;
      foto: string;
      notas?: string;
    };
  };
}

const { trek } = Astro.props;
const { data } = trek;

const formattedDate = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(data.fecha);

const desnivelText = typeof data.desnivel === 'number' ? `+${data.desnivel} m` : data.desnivel;
---

<article class="bg-white rounded-2xl border border-amber-900/10 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col group">
  {/* Trek Image Cover */}
  <div class="h-48 sm:h-52 w-full overflow-hidden bg-slate-100 relative">
    <img
      src={baseUrl(data.foto)}
      alt={data.nombre}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    
    {/* Elevation & Distance Pills */}
    <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between pointer-events-none">
      <div class="bg-verde-bosque/95 backdrop-blur text-espuma px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 shadow">
        <span>🥾</span>
        <span>{data.distancia_km} km</span>
      </div>
      <div class="bg-pizarra/90 backdrop-blur text-espuma px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 shadow">
        <span>⛰️</span>
        <span>{desnivelText}</span>
      </div>
    </div>
  </div>

  <div class="p-6 flex-grow flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
        <span class="font-medium flex items-center gap-1 text-verde-lupulo">
          <span>📍</span> {data.lugar}
        </span>
        <span class="font-mono">{formattedDate}</span>
      </div>

      <h3 class="font-display font-extrabold text-xl text-pizarra group-hover:text-verde-bosque transition-colors leading-snug mt-1">
        <a href={baseUrl(`/trekking/${trek.id}`)}>
          {data.nombre}
        </a>
      </h3>

      {data.notas && (
        <p class="mt-3 text-sm text-slate-600 line-clamp-3 leading-relaxed">
          {data.notas}
        </p>
      )}
    </div>

    <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
      <span class="text-xs font-semibold text-ambar-dorado flex items-center gap-1">
        <span>🏔️</span> Ruta de Montaña
      </span>
      <a
        href={baseUrl(`/trekking/${trek.id}`)}
        class="text-xs font-bold text-verde-bosque hover:text-verde-lupulo inline-flex items-center gap-1 group/btn"
      >
        <span>Ver itinerario</span>
        <svg class="w-4 h-4 transition-transform group-hover/btn:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</article>
