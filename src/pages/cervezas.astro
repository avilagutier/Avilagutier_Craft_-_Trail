---
import Layout from '../layouts/Layout.astro';
import BeerCard from '../components/BeerCard.astro';
import { getCollection } from 'astro:content';
import { baseUrl } from '../utils/url';

const beers = (await getCollection('cervezas')).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()
);

// Extract unique cities & styles for filters
const cities = Array.from(new Set(beers.map((b) => b.data.ciudad)));
const styles = Array.from(new Set(beers.map((b) => b.data.estilo)));
---

<Layout 
  title="Cervezas & Pubs"
  description="Catas detalladas estilo Untappd de cervezas artesanas en pubs de todo el mundo."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    {/* Page Header */}
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 pb-6 border-b border-amber-900/10">
      <div>
        <div class="flex items-center gap-2 text-xs font-semibold text-ambar-malta uppercase tracking-wider mb-2">
          <span>🍺 Cuaderno de Cata</span>
          <span>•</span>
          <span>Estilo Untappd</span>
        </div>
        <h1 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl text-pizarra tracking-tight">
          Cervezas &amp; Pubs
        </h1>
        <p class="mt-2 text-base text-slate-600 max-w-xl">
          Exploración de maltas, lúpulos salvajes y tabernas con alma. Puntuaciones objetivas del 1 al 5 y notas de degustación.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={baseUrl('/mapa')}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-pizarra font-bold text-sm shadow-sm transition-all hover:shadow"
        >
          <span>🗺️ Ver en el Mapa</span>
        </a>
      </div>
    </div>

    {/* Filter Controls (City, Style, Search) */}
    <div class="bg-white p-4 sm:p-5 rounded-2xl border border-amber-900/10 shadow-sm mb-8 space-y-4">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        {/* Search Bar */}
        <div class="relative flex-grow max-w-md">
          <input
            type="text"
            id="beer-search"
            placeholder="Buscar por nombre, pub o notas..."
            class="w-full pl-10 pr-4 py-2 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-ambar-dorado focus:border-transparent bg-slate-50"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        {/* Counter */}
        <div class="text-xs font-semibold text-slate-500 flex items-center justify-between sm:justify-end gap-2">
          <span>Mostrando:</span>
          <span id="beer-counter" class="bg-amber-100 text-amber-900 font-mono px-2 py-0.5 rounded-md font-bold">
            {beers.length} cervezas
          </span>
        </div>
      </div>

      {/* City Filters */}
      <div class="flex items-center gap-2 flex-wrap pt-2 border-t border-slate-100">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mr-1">Ciudad:</span>
        <button
          type="button"
          data-city-filter="all"
          class="city-btn active px-3 py-1 rounded-lg text-xs font-bold transition-colors bg-pizarra text-espuma"
        >
          Todas
        </button>
        {cities.map((city) => (
          <button
            type="button"
            data-city-filter={city.toLowerCase()}
            class="city-btn px-3 py-1 rounded-lg text-xs font-bold transition-colors bg-slate-100 text-slate-700 hover:bg-amber-100"
          >
            📍 {city}
          </button>
        ))}
      </div>

      {/* Style Filters */}
      <div class="flex items-center gap-2 flex-wrap pt-1">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mr-1">Estilo:</span>
        <button
          type="button"
          data-style-filter="all"
          class="style-btn active px-3 py-1 rounded-lg text-xs font-bold transition-colors bg-verde-bosque text-espuma"
        >
          Todos
        </button>
        {styles.map((style) => (
          <button
            type="button"
            data-style-filter={style.toLowerCase()}
            class="style-btn px-3 py-1 rounded-lg text-xs font-bold transition-colors bg-slate-100 text-slate-700 hover:bg-green-100"
          >
            🌾 {style}
          </button>
        ))}
      </div>
    </div>

    {/* Beer Cards Grid */}
    <div id="beer-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {beers.map((beer) => (
        <BeerCard beer={beer} />
      ))}
    </div>

    {/* Empty State */}
    <div id="empty-state" class="hidden text-center py-16 bg-white rounded-2xl border border-dashed border-slate-300">
      <span class="text-4xl block mb-2">🍺</span>
      <h3 class="font-display font-bold text-lg text-pizarra">No se encontraron cervezas</h3>
      <p class="text-sm text-slate-500 mt-1">Prueba a restablecer los filtros o buscar con otro término.</p>
      <button
        id="reset-filters"
        class="mt-4 px-4 py-2 bg-amber-500 hover:bg-amber-600 text-pizarra font-bold text-xs rounded-xl transition-all"
      >
        Restablecer todos los filtros
      </button>
    </div>

  </div>

  {/* Client Filter Logic */}
  <script>
    const searchInput = document.getElementById('beer-search') as HTMLInputElement | null;
    const cityButtons = document.querySelectorAll<HTMLButtonElement>('.city-btn');
    const styleButtons = document.querySelectorAll<HTMLButtonElement>('.style-btn');
    const cards = document.querySelectorAll<HTMLElement>('.beer-card');
    const counter = document.getElementById('beer-counter');
    const emptyState = document.getElementById('empty-state');
    const resetBtn = document.getElementById('reset-filters');

    let activeCity = 'all';
    let activeStyle = 'all';
    let searchQuery = '';

    function filterBeers() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardCity = card.getAttribute('data-ciudad') || '';
        const cardStyle = card.getAttribute('data-estilo') || '';
        const cardText = card.textContent?.toLowerCase() || '';

        const matchesCity = activeCity === 'all' || cardCity === activeCity;
        const matchesStyle = activeStyle === 'all' || cardStyle === activeStyle;
        const matchesSearch = !searchQuery || cardText.includes(searchQuery);

        if (matchesCity && matchesStyle && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (counter) {
        counter.textContent = `${visibleCount} cervezas`;
      }

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    // City Button Click
    cityButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        cityButtons.forEach((b) => {
          b.classList.remove('bg-pizarra', 'text-espuma', 'active');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.add('bg-pizarra', 'text-espuma', 'active');
        btn.classList.remove('bg-slate-100', 'text-slate-700');

        activeCity = btn.getAttribute('data-city-filter') || 'all';
        filterBeers();
      });
    });

    // Style Button Click
    styleButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        styleButtons.forEach((b) => {
          b.classList.remove('bg-verde-bosque', 'text-espuma', 'active');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.add('bg-verde-bosque', 'text-espuma', 'active');
        btn.classList.remove('bg-slate-100', 'text-slate-700');

        activeStyle = btn.getAttribute('data-style-filter') || 'all';
        filterBeers();
      });
    });

    // Search Input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        filterBeers();
      });
    }

    // Reset Button
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        activeCity = 'all';
        activeStyle = 'all';

        cityButtons.forEach((b) => {
          const isAll = b.getAttribute('data-city-filter') === 'all';
          b.classList.toggle('bg-pizarra', isAll);
          b.classList.toggle('text-espuma', isAll);
          b.classList.toggle('bg-slate-100', !isAll);
          b.classList.toggle('text-slate-700', !isAll);
        });

        styleButtons.forEach((b) => {
          const isAll = b.getAttribute('data-style-filter') === 'all';
          b.classList.toggle('bg-verde-bosque', isAll);
          b.classList.toggle('text-espuma', isAll);
          b.classList.toggle('bg-slate-100', !isAll);
          b.classList.toggle('text-slate-700', !isAll);
        });

        filterBeers();
      });
    }
  </script>
</Layout>
