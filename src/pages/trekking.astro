---
import Layout from '../layouts/Layout.astro';
import TrekCard from '../components/TrekCard.astro';
import { getCollection } from 'astro:content';
import { baseUrl } from '../utils/url';

const treks = (await getCollection('trekking')).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()
);

const totalKm = treks.reduce((acc, t) => acc + t.data.distancia_km, 0);
---

<Layout 
  title="Routes & Trekking"
  description="Alpine trails, high-mountain huts, mountain summits, and wild itineraries."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    {/* Page Header */}
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 pb-6 border-b border-amber-900/10">
      <div>
        <div class="flex items-center gap-2 text-xs font-semibold text-verde-lupulo uppercase tracking-wider mb-2">
          <span>🥾 Mountain Journal</span>
          <span>•</span>
          <span>Alpine Routes</span>
        </div>
        <h1 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl text-pizarra tracking-tight">
          Routes &amp; Trekking
        </h1>
        <p class="mt-2 text-base text-slate-600 max-w-xl">
          Ascents to high-elevation refuges, rugged gorges, and wild alpine passes. Technical specs, elevation profiles, and GPS coordinates.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={baseUrl('/mapa')}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-verde-lupulo hover:bg-verde-bosque text-espuma font-bold text-sm shadow-sm transition-all hover:shadow"
        >
          <span>🗺️ View on Map</span>
        </a>
      </div>
    </div>

    {/* Trek Stats Banner */}
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-8">
      <div class="bg-white p-4 rounded-2xl border border-amber-900/10 shadow-sm flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-green-100 text-verde-lupulo flex items-center justify-center text-xl font-bold">
          🥾
        </div>
        <div>
          <span class="text-xs text-slate-400 font-medium block">Logged Routes</span>
          <span class="text-lg font-black text-pizarra">{treks.length} trails</span>
        </div>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-amber-900/10 shadow-sm flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-900 flex items-center justify-center text-xl font-bold">
          📏
        </div>
        <div>
          <span class="text-xs text-slate-400 font-medium block">Total Distance</span>
          <span class="text-lg font-black text-pizarra">{totalKm.toFixed(1)} km</span>
        </div>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-amber-900/10 shadow-sm col-span-2 sm:col-span-1 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-900 flex items-center justify-center text-xl font-bold">
          ⛰️
        </div>
        <div>
          <span class="text-xs text-slate-400 font-medium block">Elevation Gain</span>
          <span class="text-lg font-black text-pizarra">+0 m</span>
        </div>
      </div>
    </div>

    {/* Treks Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {treks.length > 0 ? (
        treks.map((trek) => (
          <TrekCard trek={trek} />
        ))
      ) : (
        <div class="col-span-2 text-center py-16 bg-white rounded-2xl border border-dashed border-slate-300">
          <span class="text-4xl block mb-2">🥾</span>
          <h3 class="font-display font-bold text-lg text-pizarra">Upcoming mountain trails</h3>
          <p class="text-sm text-slate-500 mt-1">New alpine ascents and Sicilian / European routes will be published soon.</p>
        </div>
      )}
    </div>

  </div>
</Layout>
