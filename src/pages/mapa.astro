---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { baseUrl } from '../utils/url';

// Fetch all entries from all 3 Content Collections
const cervezas = await getCollection('cervezas');
const viajes = await getCollection('viajes');
const trekking = await getCollection('trekking');

// Prepare unified map pins data
const mapPoints = [
  ...cervezas.map((c) => ({
    id: `cerveza-${c.id}`,
    category: 'cervezas',
    categoryName: 'Craft Tasted',
    title: c.data.nombre,
    subtitle: `${c.data.cerveceria} · ${c.data.estilo}`,
    detail: `📍 ${c.data.ciudad} · Rating: ${c.data.puntuacion} / 5 ★`,
    lat: c.data.latitud,
    lng: c.data.longitud,
    photo: baseUrl(c.data.foto),
    url: baseUrl(`/cervezas/${c.id}`),
    color: '#F59E0B', // Golden Amber
    icon: '🍺',
  })),
  ...viajes.map((v) => ({
    id: `viaje-${v.id}`,
    category: 'viajes',
    categoryName: 'Travels',
    title: v.data.titulo,
    subtitle: `${v.data.ciudad}, ${v.data.pais}`,
    detail: `Type: ${v.data.motivo.toUpperCase()} · ${v.data.resumen.substring(0, 90)}...`,
    lat: v.data.latitud,
    lng: v.data.longitud,
    photo: baseUrl(v.data.foto),
    url: baseUrl(`/viajes/${v.id}`),
    color: '#1B4332', // Forest Green
    icon: '✈️',
  })),
  ...trekking.map((t) => ({
    id: `trekking-${t.id}`,
    category: 'trekking',
    categoryName: 'Routes & Trekking',
    title: t.data.nombre,
    subtitle: t.data.lugar,
    detail: `Distance: ${t.data.distancia_km} km · Elevation: +${t.data.desnivel} m`,
    lat: t.data.latitud,
    lng: t.data.longitud,
    photo: baseUrl(t.data.foto),
    url: baseUrl(`/trekking/${t.id}`),
    color: '#2D6A4F', // Hop Green
    icon: '🥾',
  })),
];
---

<Layout 
  title="Global Adventure Map"
  description="Interactive map with craft beer tastings, travel destinations, and alpine trekking trails."
>
  <link rel="stylesheet" href={baseUrl('/vendor/leaflet/leaflet.css')} slot="head" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    {/* Page Title & Breadcrumbs */}
    <div class="mb-6">
      <div class="flex items-center gap-2 text-xs font-semibold text-verde-lupulo uppercase tracking-wider mb-2">
        <span>🗺️ Cartographic Exploration</span>
        <span>•</span>
        <span>OpenStreetMap + Leaflet.js</span>
      </div>
      <h1 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl text-pizarra tracking-tight">
        Global Expeditions Map
      </h1>
      <p class="mt-2 text-base sm:text-lg text-slate-600 max-w-2xl">
        Discover every visited pub, conquered summit, and explored corner. Tap any interactive pin to view tasting notes, coordinates, and full details.
      </p>
    </div>

    {/* Filter Buttons Bar */}
    <div class="bg-white p-3 sm:p-4 rounded-2xl border border-amber-900/10 shadow-sm mb-6 flex flex-wrap items-center justify-between gap-3">
      
      <div class="flex flex-wrap items-center gap-2" id="filter-buttons">
        <button
          type="button"
          data-filter="all"
          class="filter-btn active px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all shadow-sm flex items-center gap-1.5 bg-pizarra text-espuma border border-pizarra"
        >
          <span>🌐 All Pins</span>
          <span class="bg-white/20 text-espuma px-1.5 py-0.2 rounded-full text-[11px] font-mono">
            {mapPoints.length}
          </span>
        </button>

        <button
          type="button"
          data-filter="cervezas"
          class="filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all shadow-sm flex items-center gap-1.5 bg-slate-100 text-slate-700 hover:bg-amber-100 hover:text-amber-900 border border-slate-200"
        >
          <span>🍺 Craft Tasted</span>
          <span class="bg-amber-200 text-amber-900 px-1.5 py-0.2 rounded-full text-[11px] font-mono">
            {cervezas.length}
          </span>
        </button>

        <button
          type="button"
          data-filter="viajes"
          class="filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all shadow-sm flex items-center gap-1.5 bg-slate-100 text-slate-700 hover:bg-emerald-100 hover:text-emerald-900 border border-slate-200"
        >
          <span>✈️ Travels</span>
          <span class="bg-emerald-200 text-emerald-900 px-1.5 py-0.2 rounded-full text-[11px] font-mono">
            {viajes.length}
          </span>
        </button>

        <button
          type="button"
          data-filter="trekking"
          class="filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all shadow-sm flex items-center gap-1.5 bg-slate-100 text-slate-700 hover:bg-green-100 hover:text-green-900 border border-slate-200"
        >
          <span>🥾 Trekking</span>
          <span class="bg-green-200 text-green-900 px-1.5 py-0.2 rounded-full text-[11px] font-mono">
            {trekking.length}
          </span>
        </button>
      </div>

      <div class="text-xs text-slate-500 hidden sm:flex items-center gap-1">
        <span>📍 Pins color-coded by category</span>
      </div>
    </div>

    {/* Map Container */}
    <div class="relative bg-slate-100 rounded-3xl overflow-hidden border-2 border-amber-900/10 shadow-xl">
      <div id="global-map" class="w-full h-[65vh] min-h-[500px] z-10"></div>
      
      {/* Mobile Map Legend Floating Card */}
      <div class="absolute bottom-4 left-4 z-20 bg-white/95 backdrop-blur-md px-3.5 py-2.5 rounded-xl shadow-lg border border-slate-200 text-xs hidden sm:flex items-center gap-4">
        <span class="flex items-center gap-1.5 font-medium text-slate-700">
          <span class="w-3 h-3 rounded-full bg-ambar-dorado inline-block"></span> Craft Beers
        </span>
        <span class="flex items-center gap-1.5 font-medium text-slate-700">
          <span class="w-3 h-3 rounded-full bg-verde-bosque inline-block"></span> Travels
        </span>
        <span class="flex items-center gap-1.5 font-medium text-slate-700">
          <span class="w-3 h-3 rounded-full bg-verde-lupulo inline-block"></span> Trekking
        </span>
      </div>
    </div>

  </div>

  <script src={baseUrl('/vendor/leaflet/leaflet.js')} is:inline></script>
  
  <script is:inline define:vars={{ mapPoints }}>
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof L === 'undefined') {
        console.error('Leaflet is not loaded');
        return;
      }

      const map = L.map('global-map', {
        scrollWheelZoom: false,
      }).setView([46.0, 10.0], 5);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 18,
      }).addTo(map);

      const markersGroup = L.layerGroup().addTo(map);
      const allMarkers = [];

      function createCustomIcon(iconChar, color) {
        return L.divIcon({
          className: 'custom-map-pin',
          html: `
            <div style="
              background-color: ${color};
              width: 38px;
              height: 38px;
              border-radius: 50% 50% 50% 0;
              transform: rotate(-45deg);
              display: flex;
              align-items: center;
              justify-content: center;
              border: 3px solid #FAF8F5;
              box-shadow: 0 4px 10px rgba(15, 23, 42, 0.35);
              transition: transform 0.2s ease;
            ">
              <span style="
                transform: rotate(45deg);
                font-size: 16px;
                line-height: 1;
              ">${iconChar}</span>
            </div>
          `,
          iconSize: [38, 38],
          iconAnchor: [19, 38],
          popupAnchor: [0, -38],
        });
      }

      mapPoints.forEach((point) => {
        const icon = createCustomIcon(point.icon, point.color);
        const marker = L.marker([point.lat, point.lng], { icon });

        const popupContent = `
          <div style="font-family: system-ui, sans-serif; max-width: 220px; padding: 4px;">
            ${point.photo ? `
              <div style="width: 100%; height: 110px; border-radius: 8px; overflow: hidden; margin-bottom: 8px; background: #eee;">
                <img src="${point.photo}" alt="${point.title}" style="width: 100%; height: 100%; object-fit: cover;" />
              </div>
            ` : ''}
            <span style="display: inline-block; font-size: 10px; font-weight: 700; text-transform: uppercase; color: ${point.color}; margin-bottom: 2px;">
              ${point.categoryName}
            </span>
            <h4 style="margin: 0 0 4px 0; font-size: 14px; font-weight: 800; color: #0F172A; line-height: 1.2;">
              ${point.title}
            </h4>
            <p style="margin: 0 0 4px 0; font-size: 12px; font-weight: 600; color: #475569;">
              ${point.subtitle}
            </p>
            <p style="margin: 0 0 8px 0; font-size: 11px; color: #64748B;">
              ${point.detail}
            </p>
            <a href="${point.url}" style="
              display: inline-block;
              font-size: 11px;
              font-weight: 700;
              color: #FAF8F5;
              background-color: #1B4332;
              padding: 4px 10px;
              border-radius: 6px;
              text-decoration: none;
            ">
              View full notes →
            </a>
          </div>
        `;

        marker.bindPopup(popupContent);
        markersGroup.addLayer(marker);
        allMarkers.push({ marker, category: point.category });
      });

      if (mapPoints.length > 0) {
        const bounds = L.latLngBounds(mapPoints.map((p) => [p.lat, p.lng]));
        map.fitBounds(bounds, { padding: [50, 50], maxZoom: 14 });
      }

      const buttons = document.querySelectorAll('.filter-btn');
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          buttons.forEach((b) => {
            b.classList.remove('active', 'bg-pizarra', 'text-espuma', 'border-pizarra');
            b.classList.add('bg-slate-100', 'text-slate-700', 'border-slate-200');
          });

          btn.classList.add('active', 'bg-pizarra', 'text-espuma', 'border-pizarra');
          btn.classList.remove('bg-slate-100', 'text-slate-700', 'border-slate-200');

          const category = btn.getAttribute('data-filter');

          markersGroup.clearLayers();
          const filtered = category === 'all'
            ? allMarkers
            : allMarkers.filter((m) => m.category === category);

          filtered.forEach((m) => markersGroup.addLayer(m.marker));

          if (filtered.length > 0) {
            const visibleLatLngs = filtered.map((m) => m.marker.getLatLng());
            const bounds = L.latLngBounds(visibleLatLngs);
            map.fitBounds(bounds, { padding: [50, 50], maxZoom: 14 });
          }
        });
      });
    });
  </script>
</Layout>
